# .env.local にコピーして使う(.env.local は git 管理外)

# 既定のプロバイダ: anthropic | openai | ollama
AI_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol

# Ollama(ローカル実行。API キー不要。事前に `ollama pull granite4.2` 等でモデルを取得)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=granite4.2:latest

# /api/chat のレート制限(クライアント IP ごと・固定ウィンドウ)。プロセス内メモリで数えるため、
# 複数インスタンス構成ではインスタンスごとの値になる
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
