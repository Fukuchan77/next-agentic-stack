# .env.local にコピーして使う(.env.local は git 管理外)

# 既定のプロバイダ: anthropic | openai | ollama
AI_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Ollama(ローカル実行。API キー不要。事前に `ollama pull qwen3` 等でモデルを取得)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3
