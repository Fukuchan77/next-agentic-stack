{
	"name": "robust-react-ts-template",
	"author": "Fukuchan77",
	"license": "MIT",
	"private": true,
	"version": "1.0.0",
	"dependencies": {
		"@carbon/react": "^1.102.0",
		"@carbon/styles": "^1.101.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@playwright/test": "^1.50.0",
		"@size-limit/file": "^12.1.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.5.2",
		"@types/node": "^22.13.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/coverage-v8": "^4.1.8",
		"jsdom": "^28.1.0",
		"sass": "^1.100.0",
		"size-limit": "^12.1.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"pnpm": {
		"overrides": {
			"undici@>=7.0.0 <7.24.0": "^7.24.0",
			"picomatch@>=4.0.0 <4.0.4": "^4.0.4",
			"postcss@<8.5.10": "^8.5.15",
			"immutable@>=5.0.0 <5.1.5": "^5.1.6"
		}
	},
	"scripts": {
		"dev": "vite --port 3000 --open",
		"build": "tsc -b && vite build",
		"preview": "vite preview --port 3000",
		"test": "vitest",
		"test:run": "vitest run",
		"test:e2e": "playwright test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"size": "size-limit"
	},
	"size-limit": [
		{
			"name": "JS bundle (brotli)",
			"path": "dist/assets/*.js",
			"limit": "80 kB"
		},
		{
			"name": "CSS bundle (brotli)",
			"path": "dist/assets/*.css",
			"limit": "12 kB"
		}
	]
}
